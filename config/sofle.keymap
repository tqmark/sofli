#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define APPS 4

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <4 5>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <36 37>;
            layers = <BASE>;
        };

        apps {
            bindings = <&sl APPS>;
            key-positions = <38 39>;
            layers = <BASE>;
        };
    };

    behaviors {
        spaceshiftdot: spaceshiftdot {
            compatible = "zmk,behavior-tap-dance";
            label = "SPACESHIFTDOT";
            #binding-cells = <0>;
            bindings = <&mt LSHIFT SPACE>, <&kp DOT>;
        };

        optionquestion: optionquestion {
            compatible = "zmk,behavior-tap-dance";
            label = "OPTIONQUESTION";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT SLASH>, <&mo 1>;
        };

        entercommand: entercommand {
            compatible = "zmk,behavior-tap-dance";
            label = "ENTERCOMMAND";
            #binding-cells = <0>;
            bindings = <&mt LEFT_COMMAND ENTER>, <&kp COMMA>;
        };

        Ienter: Ienter {
            compatible = "zmk,behavior-tap-dance";
            label = "IENTER";
            #binding-cells = <0>;
            bindings = <&kp I>, <&kp ENTER>;
        };

        klayer1: klayer1 {
            compatible = "zmk,behavior-tap-dance";
            label = "KLAYER1";
            #binding-cells = <0>;
            bindings = <&kp K>, <&to 1>;
        };

        zlayer2: zlayer2 {
            compatible = "zmk,behavior-tap-dance";
            label = "ZLAYER2";
            #binding-cells = <0>;
            bindings = <&kp Z>, <&to 2>;
        };

        esccontrllayer0: esccontrllayer0 {
            compatible = "zmk,behavior-tap-dance";
            label = "ESCCONTRLLAYER0";
            #binding-cells = <0>;
            bindings = <&mt LEFT_CONTROL ESC>, <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // Left half: all letters plus thumb tap/hold behaviors. The right half is disconnected.
            // | Q | P | F | M | L | J |
            // | B | Y | U | R | S | O |
            // | C | D | T | H | E | A |
            // | X | G | V | W | N | I | K |
            //     | Z/LOWER | ESC/CTRL | SLASH/ALT | ENTER/CMD | SPACE/SHIFT |

            bindings = <
&kp Q  &kp P  &kp F    &kp M                 &kp L            &kp J                                       &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &none
&kp B  &kp Y  &kp U    &kp R                 &kp S            &kp O                                       &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp C  &kp D  &kp T    &kp H                 &kp E            &kp A                                       &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp X  &kp G  &kp V    &kp W                 &lt 1 N          &kp I          &klayer1          &none      &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
              &lt 1 Z  &mt LEFT_CONTROL ESC  &optionquestion  &entercommand  &spaceshiftdot    &kp SPACE  &mo RAISE  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";

            // Left half:
            // | 1 | 2 | 3 | 4 | 5 | 6 |
            // | 7 | 8 | 9 | 0 | - | = |
            // | ' | " | ; | : | [ | ] |
            // | \ | RAISE | - | + | , | . | ADJUST |
            //     | BASE | sticky CTRL | SLASH/ALT | sticky CMD | SPACE/SHIFT |

            bindings = <
&kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4          &kp N5            &kp NUMBER_6                                 &kp F6     &kp F7    &kp F8     &kp F9     &kp F10   &kp F11
&kp N7          &kp N8        &kp N9        &kp N0                &kp MINUS         &kp EQUAL                                    &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &kp F12
&kp SQT         &kp DQT       &kp SEMI      &kp COLON             &kp LEFT_BRACKET  &kp RIGHT_BRACKET                            &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR  &kp PIPE
&kp BSLH        &to RAISE     &kp MINUS     &kp PLUS              &kp COMMA         &kp PERIOD         &to ADJUST       &trans  &kp LBKT   &kp RBKT  &kp SEMI   &kp COLON  &kp BSLH  &trans
                              &to BASE      &sk LCTRL              &optionquestion   &sk LGUI           &spaceshiftdot    &trans  &trans     &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";

            // Left half navigation and editing:
            // |       |      |      |       |        |        |
            // | PG UP | HOME | UP   | END   | PG DN  | DELETE |
            // | BSPC  | LEFT | DOWN | RIGHT | INSERT | PRINT  |
            // |       | UNDO | CUT  | COPY  | PASTE  |        | BASE |

            bindings = <
&trans      &trans        &trans        &trans             &trans           &trans                                   &trans     &trans    &trans    &trans     &trans   &trans
&kp PG_UP   &kp HOME      &kp UP        &kp END            &kp PG_DN        &kp DEL                                 &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &trans
&kp BSPC    &kp LEFT      &kp DOWN      &kp RIGHT          &kp INS          &kp PSCRN                               &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY        &kp K_PASTE      &trans         &to 0             &trans  &trans     &trans    &trans    &trans     &trans   &trans
                          &to BASE      &esccontrllayer0  &optionquestion  &entercommand  &spaceshiftdot    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                            &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                      &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &to BASE             &none  &none  &none  &none  &none  &none  &none
                                    &to BASE         &none            &none            &none            &none                &none  &none  &none  &none  &none
            >;
        };

        apps_layer {
            display-name = "apps";

            // V+W activates this layer for one keypress.
            // B browser, T terminal, N notes, C chat, S settings, M messages, F Finder.
            bindings = <
&trans    &trans  &kp F19  &kp F18  &trans   &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&kp F13   &trans  &trans   &trans   &kp F17  &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&kp F16   &trans  &kp F14  &trans   &trans   &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans   &trans   &kp F15  &trans   &to BASE     &trans  &trans  &trans  &trans  &trans  &trans  &trans
                  &to BASE &trans   &trans   &trans    &trans       &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
