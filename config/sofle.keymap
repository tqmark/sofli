#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2

/ {
    macros {
        ghostty_layout_1: ghostty_layout_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(A) &kp N1>;
        };

        ghostty_layout_2: ghostty_layout_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(A) &kp N2>;
        };

        ghostty_layout_3: ghostty_layout_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(A) &kp N3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <4 5>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <36 37>;
            layers = <BASE>;
        };

        raise_once {
            bindings = <&sl RAISE>;
            key-positions = <38 39>;
            layers = <BASE>;
        };

        clear_bluetooth {
            bindings = <&bt BT_CLR>;
            key-positions = <0 5>;
            layers = <RAISE>;
            timeout-ms = <150>;
        };
    };

    behaviors {
        spaceshiftdot: spaceshiftdot {
            compatible = "zmk,behavior-tap-dance";
            label = "SPACESHIFTDOT";
            #binding-cells = <0>;
            bindings = <&mt LSHIFT SPACE>, <&kp DOT>;
        };

        optionquestion: optionquestion {
            compatible = "zmk,behavior-tap-dance";
            label = "OPTIONQUESTION";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT SLASH>, <&mo LOWER>;
        };

        entercommand: entercommand {
            compatible = "zmk,behavior-tap-dance";
            label = "ENTERCOMMAND";
            #binding-cells = <0>;
            bindings = <&mt LEFT_COMMAND ENTER>, <&kp COMMA>;
        };

        Ienter: Ienter {
            compatible = "zmk,behavior-tap-dance";
            label = "IENTER";
            #binding-cells = <0>;
            bindings = <&kp I>, <&kp ENTER>;
        };

        zlayers: zlayers {
            compatible = "zmk,behavior-tap-dance";
            label = "ZLAYERS";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&lt LOWER Z>, <&to RAISE>;
        };

        esccontrllayer0: esccontrllayer0 {
            compatible = "zmk,behavior-tap-dance";
            label = "ESCCONTRLLAYER0";
            #binding-cells = <0>;
            bindings = <&mt LEFT_CONTROL ESC>, <&to BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // Left half: all letters plus thumb tap/hold behaviors. The right half is disconnected.
            // | Q | P | F | M | L | J |
            // | B | Y | U | R | S | O |
            // | C | D | T | H | E | A |
            // | X | G | V | W | N | I | K/RAISE |
            //     | Z: tap Z / hold LOWER / double-tap RAISE | ESC/CTRL | SLASH/ALT | ENTER/CMD | SPACE/SHIFT |

            bindings = <
&kp Q  &kp P  &kp F    &kp M                 &kp L            &kp J                                       &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &none
&kp B  &kp Y  &kp U    &kp R                 &kp S            &kp O                                       &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp C  &kp D  &kp T    &kp H                 &kp E            &kp A                                       &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp X  &kp G  &kp V    &kp W                 &kp N             &kp I          &lt RAISE K       &none      &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
              &zlayers  &mt LEFT_CONTROL ESC  &optionquestion  &entercommand  &spaceshiftdot    &kp SPACE  &mo RAISE  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";

            // Left half:
            // | 1 | 2 | 3 | 4 | 5 | 6 |
            // | 7 | 8 | 9 | 0 | - | = |
            // | ' | WINDOW LEFT | ; | WINDOW RIGHT | [ | ] |
            // Hold Z to use this layer; release to return to Base.
            // | \ | ALMOST MAX | / | RESTORE | , | . | ` |
            //     | same thumb behaviors as Base: Z/LOWER | ESC/CTRL | SLASH/ALT | ENTER/CMD | SPACE/SHIFT |

            bindings = <
&kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4          &kp N5            &kp NUMBER_6                                 &kp F6     &kp F7    &kp F8     &kp F9     &kp F10   &kp F11
&kp N7          &kp N8        &kp N9        &kp N0                &kp MINUS         &kp EQUAL                                    &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &kp F12
&kp SQT         &kp LC(LA(H)) &kp SEMI      &kp LC(LA(L))         &kp LEFT_BRACKET  &kp RIGHT_BRACKET                            &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR  &kp PIPE
&kp BSLH        &kp LC(LA(C)) &kp SLASH     &kp LC(LA(V))         &kp COMMA         &kp PERIOD         &kp GRAVE        &trans  &kp LBKT   &kp RBKT  &kp SEMI   &kp COLON  &kp BSLH  &trans
                              &trans        &trans                 &trans             &trans             &trans           &trans  &trans     &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";

            // Hold K temporarily or double-tap Z to lock this layer; tap Z to return.
            // V+W activates it for one keypress, normally to launch an app.
            // Q+J together clears all Bluetooth pairings.
            // | BT1      | BT2 | FINDER   | MESSAGES | BT3    | BOOTLOADER |
            // | BROWSER  | BT4 | BT5      | HOME     | SETTINGS | END      |
            // | CHAT     | GHOSTTY 1 | TERMINAL | GHOSTTY 2 | GHOSTTY 3 | DELETE |
            // | LEFT     | DOWN | UP | RIGHT | NOTES | POWER | ESC |
            //     | BASE | ESC/CTRL | SLASH/ALT | ENTER/CMD | SPACE/SHIFT |

            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &kp F19   &kp F18     &bt BT_SEL 2      &bootloader                              &trans     &trans    &trans    &trans     &trans   &trans
&kp F13       &bt BT_SEL 3  &bt BT_SEL 4  &kp HOME &kp F17          &kp END                                  &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &trans
&kp F16       &ghostty_layout_1  &kp F14   &ghostty_layout_2  &ghostty_layout_3  &kp DEL                          &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&kp LEFT      &kp DOWN      &kp UP    &kp RIGHT    &kp F15          &ext_power EP_TOG  &kp ESC          &trans  &trans     &trans    &trans    &trans     &trans   &trans
                             &to BASE   &esccontrllayer0  &optionquestion  &entercommand  &spaceshiftdot    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

    };
};
